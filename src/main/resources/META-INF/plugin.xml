<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.infomaniak.MoreUsageFilters</id>
    <name>More Usage Filters</name>
    <vendor url="https://www.infomaniak.com">Infomaniak</vendor>

    <description><![CDATA[
        Two extra filter toggles for the Find Usages tool window and the Show Usages popup
        (<code>Cmd+B</code> / <code>Ctrl+B</code>), next to the built-in <i>Show Import Statements</i> and
        <i>Show Generated Code</i> ones.<br/><br/>
        <b>Show Preview Usages</b> &mdash; turn it off to hide every usage located inside a Jetpack Compose preview,
        that is a declaration annotated with <code>@Preview</code>, <code>@PreviewScreenSizes</code> or any custom
        multipreview annotation. Handy on a Composable that is, of course, always used by its own preview.<br/><br/>
        <b>Show Comment Usages</b> &mdash; turn it off to hide every usage located inside a comment, the
        <code>[Link]</code> references of a KDoc first and foremost.<br/><br/>
        Supports both the K1 and the K2 Kotlin modes, and needs no configuration.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.MoreUsageFiltersBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <usageFilteringRuleProvider
                implementation="com.infomaniak.moreusagefilters.MoreUsageFiltersRuleProvider"/>
    </extensions>

    <!-- Only the Kotlin PSI is used, no Analysis API, so both the K1 and the K2 modes are supported. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <actions>
        <!-- The platform turns these actions into the toggles shown in the usages filter toolbar,
             see com.intellij.usages.impl.UsageFilteringRuleActions. They must be EmptyActions.
             They are added to the group only so that a shortcut can be assigned from Settings | Keymap. -->
        <action id="MoreUsageFilters.ShowPreviewUsages"
                class="com.intellij.openapi.actionSystem.EmptyAction"
                icon="/icons/showPreviewUsages.svg">
            <add-to-group group-id="UsageFilteringActionGroup" anchor="last"/>
        </action>
        <action id="MoreUsageFilters.ShowCommentUsages"
                class="com.intellij.openapi.actionSystem.EmptyAction"
                icon="/icons/showCommentUsages.svg">
            <add-to-group group-id="UsageFilteringActionGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
